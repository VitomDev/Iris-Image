<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package that gives Iris the package identity Windows 11 requires for
  entries in the modern File Explorer context menu. It contains no code: the
  executables stay in the installation folder, passed as the external location
  when the package is registered.

  The publisher carries the OID Windows uses to mark unsigned packages, so the
  package can be registered without a code-signing certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity
    Name="Iris.ImageConverter"
    ProcessorArchitecture="x64"
    Publisher="CN=Iris, OID.2.25.311729368913984317654407730594956997722=1"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Iris</DisplayName>
    <PublisherDisplayName>Iris</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="Iris" Executable="Iris.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="Iris"
        Description="Instant Image Converter"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".png"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpg"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpeg"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpe"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jfif"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".webp"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".bmp"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".dib"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".gif"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".tif"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".tiff"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
            <desktop5:ItemType Type=".ico"><desktop5:Verb Id="IrisConvert" Clsid="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" /></desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Iris context menu">
              <com:Class Id="4D8C2E61-7A3B-4F0E-9C15-2B6E8A1D3F47" Path="IrisShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
