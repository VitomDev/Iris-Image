#include <winres.h>

#include "resource.h"
#include "../version.h"

IDI_IRIS ICON "../../assets/iris.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Iris.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION IRIS_VERSION_MAJOR, IRIS_VERSION_MINOR, IRIS_VERSION_PATCH, 0
 PRODUCTVERSION IRIS_VERSION_MAJOR, IRIS_VERSION_MINOR, IRIS_VERSION_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Victor Escos Batalla"
            VALUE "FileDescription", "Iris Image - Instant Image Converter"
            VALUE "FileVersion", IRIS_VERSION_STRING
            VALUE "InternalName", "Iris"
            VALUE "LegalCopyright", "Copyright (c) 2026 Victor Escos Batalla. MIT License."
            VALUE "OriginalFilename", "Iris.exe"
            VALUE "ProductName", "Iris Image"
            VALUE "ProductVersion", IRIS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
