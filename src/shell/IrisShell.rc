#include <winres.h>

#include "../version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION IRIS_VERSION_MAJOR, IRIS_VERSION_MINOR, IRIS_VERSION_PATCH, 0
 PRODUCTVERSION IRIS_VERSION_MAJOR, IRIS_VERSION_MINOR, IRIS_VERSION_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VitomDev"
            VALUE "FileDescription", "Iris Image Explorer context menu"
            VALUE "FileVersion", IRIS_VERSION_STRING
            VALUE "InternalName", "IrisShell"
            VALUE "LegalCopyright", "Copyright (c) 2026 VitomDev. MIT License."
            VALUE "OriginalFilename", "IrisShell.dll"
            VALUE "ProductName", "Iris Image"
            VALUE "ProductVersion", IRIS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
